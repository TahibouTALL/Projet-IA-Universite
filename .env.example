# Nom affiché de la plateforme
NEXT_PUBLIC_APP_NAME="Campus IA"

# Base de données PostgreSQL
DATABASE_URL="postgresql://campus:campus@localhost:5432/campus?schema=public"

# Authentification (générer avec : openssl rand -base64 32)
NEXTAUTH_SECRET="change-moi"
NEXTAUTH_URL="http://localhost:3000"

# Restreindre l'inscription à un domaine (ex : ept.sn). Laisser vide pour ouvrir.
ALLOWED_EMAIL_DOMAIN=""

# Stockage des fichiers déposés : local (disque du serveur) | s3 (Cloudflare R2, MinIO, AWS S3)
# Sur Vercel, utiliser obligatoirement s3 et MAX_UPLOAD_MB=4 (limite de taille des requêtes Vercel)
STORAGE_DRIVER="local"
UPLOAD_DIR="./storage"
MAX_UPLOAD_MB=20
S3_ENDPOINT=""            # Supabase : https://<projet>.storage.supabase.co/storage/v1/s3
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_REGION="auto"          # Supabase : la région affichée (ex : eu-central-1)
S3_FORCE_PATH_STYLE="false" # Supabase et MinIO : true

# Connexions simultanées à la base (mettre 3 sur Vercel)
DB_POOL_MAX=10

# Fournisseur IA : groq | openrouter | gemini | anthropic | openai | mock
#  - groq : offre gratuite, clé sur https://console.groq.com/keys (recommandé pour démarrer)
#  - mock : réponses simulées, pour tester sans clé
#  - openai accepte aussi toute API compatible (Ollama, vLLM, LM Studio) via AI_BASE_URL
#  - AI_MODEL vide = modèle par défaut du fournisseur
AI_PROVIDER="mock"
AI_API_KEY=""
AI_MODEL=""
AI_BASE_URL=""

# Compte administrateur créé au premier lancement (à changer ensuite)
SEED_ADMIN_EMAIL="admin@campus.test"
SEED_ADMIN_PASSWORD="change-moi-vite"

# Docker Compose uniquement
POSTGRES_PASSWORD="campus"
APP_PORT=3000
